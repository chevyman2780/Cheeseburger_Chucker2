<Project>


    <PropertyGroup>
        <OutputPath>build/</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)/build/obj/</BaseIntermediateOutputPath>
        <IntermediateOutputPath>$(MSBuildProjectDirectory)/build/obj/</IntermediateOutputPath>
    </PropertyGroup>

    <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <RollForward>Major</RollForward>
        <ImplicitUsings>enable</ImplicitUsings>
        <FNADir>$(MSBuildProjectDirectory)/deps/FNA</FNADir>
        <NativeDir>$(FNADir)/fnalibs</NativeDir>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="$(FNADir)/FNA.Core.csproj" />
    </ItemGroup>

      <!-- Don't compile FNA's source as part of the game; it's built via the project reference -->
  <ItemGroup>
    <Compile Remove="deps/FNA/**" />
    <None Remove="deps/FNA/**" />
    <EmbeddedResource Remove="deps/FNA/**" />
    <None Include="assets/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

    <Target Name="FnaNatives" AfterTargets="Build">
    <ItemGroup>
      <NativeLib Condition="$([MSBuild]::IsOSPlatform('Windows'))" Include="$(NativeDir)/x64/*.dll" />
      <NativeLib Condition="$([MSBuild]::IsOSPlatform('Linux'))"   Include="$(NativeDir)/lib64/*.so*" />
      <NativeLib Condition="$([MSBuild]::IsOSPlatform('OSX'))"     Include="$(NativeDir)/osx/*.dylib" />
    </ItemGroup>
    <Warning Condition="'@(NativeLib)' == ''"
             Text="No native libs found in $(NativeDir). Put the fnalibs folders (x64, lib64, osx) there." />
    <Copy SourceFiles="@(NativeLib)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

    <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>